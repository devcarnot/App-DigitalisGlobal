# Same Supabase project as the main Digitalis site (URL + keys from that project’s dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (e.g. https://app.digitalisglobal.com). Used in emails and invite links.
# Add the same URL under Supabase Auth → URL Configuration → Redirect / Site URL as needed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production only (Vercel → Production env): comma-separated hosts allowed on the Host header.
# Omit locally. Example: PRODUCTION_ALLOWED_HOSTS=app.digitalisglobal.com
# PRODUCTION_ALLOWED_HOSTS=

# Optional: Resend, push (VAPID), Jitsi, cron — copy from the main app’s .env if you use those features.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@example.com
# CRON_SECRET=
# JITSI_ROOM_SECRET=
# ERP_PORTAL_ADMIN_EMAILS=
# ERP_ADMIN_EMAILS=
# NEXT_PUBLIC_ADMIN_DASHBOARD_EMAILS=
