# Same Supabase project as the main Digitalis site (URL + keys from that project’s dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this ERP deployment (no trailing slash). Local: localhost. Production: usually the app host, e.g.:
#   NEXT_PUBLIC_SITE_URL=https://app.digitalisglobal.com
# (Marketing site may be https://www.digitalisglobal.com — that is separate; do not use www here if the workspace lives on app.)
# Drives: password-reset redirectTo, invite links, notification URLs, email footers.
# Supabase → Authentication → URL Configuration → Redirect URLs must include:
#   https://app.digitalisglobal.com/erp/reset-password
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Production (https://app.digitalisglobal.com/) — paste these into Vercel / host env ---
# NEXT_PUBLIC_SITE_URL=https://app.digitalisglobal.com
# PRODUCTION_ALLOWED_HOSTS=app.digitalisglobal.com

# Desktop installer hosting (recommended with Vercel):
# 1) Upload the .exe to Vercel Blob (or any object storage) and set this SERVER env to the direct file URL:
# DESKTOP_WINDOWS_ASSET_URL=https://<your-blob-or-cdn>/digitalis-workspace-setup.exe
# 2) Keep the public URL stable (this repo provides a redirect endpoint at /downloads/digitalis-workspace-setup.exe):
# NEXT_PUBLIC_DESKTOP_WINDOWS_DOWNLOAD_URL=/downloads/digitalis-workspace-setup.exe

# Landing download CTAs: same-origin path works too after sync-installer places the exe locally:
# NEXT_PUBLIC_DESKTOP_WINDOWS_DOWNLOAD_URL=/downloads/digitalis-workspace-setup.exe
# Build exe → npm run desktop:dist:win && npm run desktop:sync-installer → redeploy site.
#
# Electron shell (desktop/) — optional overrides when running `DIGITALIS_WORKSPACE_ORIGIN=... npm run desktop:start`
# (NOT read by Next.js; use only when testing the Electron window against localhost). See desktop/README.md.
# DIGITALIS_WORKSPACE_ORIGIN=http://localhost:3000
# DIGITALIS_START_PATH=/erp/login

# Optional: Resend, push (VAPID), Jitsi, cron — copy from the main app's .env if you use those features.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@example.com
# CRON_SECRET=
# JITSI_ROOM_SECRET=
# ERP_PORTAL_ADMIN_EMAILS=
# ERP_ADMIN_EMAILS=
# NEXT_PUBLIC_ADMIN_DASHBOARD_EMAILS=
