# Same Supabase project as the main Digitalis site (URL + keys from that project’s dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this ERP deployment (no trailing slash). Local: localhost. Production: usually the app host, e.g.:
#   NEXT_PUBLIC_SITE_URL=https://app.digitalisglobal.com
# (Marketing site may be https://www.digitalisglobal.com — that is separate; do not use www here if the workspace lives on app.)
# Drives: password-reset redirectTo, Google OAuth redirect, invite links, notification URLs, email footers.
# --- Google sign-in (Supabase Auth) ---
# 1) Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
#    Authorized JavaScript origins: http://localhost:3000 , https://app.digitalisglobal.com
#    Authorized redirect URIs: https://<YOUR-PROJECT-REF>.supabase.co/auth/v1/callback
# 2) Supabase Dashboard → Authentication → Providers → Google → Enable, paste Client ID + Secret
# 3) Supabase → Authentication → URL Configuration → Redirect URLs (add each origin):
#    http://localhost:3000/erp/auth/callback
#    https://app.digitalisglobal.com/erp/auth/callback
#    (and /erp/reset-password on the same hosts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Production (https://app.digitalisglobal.com/) — paste these into Vercel / host env ---
# NEXT_PUBLIC_SITE_URL=https://app.digitalisglobal.com
# PRODUCTION_ALLOWED_HOSTS=app.digitalisglobal.com

# Desktop installer hosting (recommended with Vercel):
# Windows — upload .exe, set server redirect URL, keep stable public path:
# DESKTOP_WINDOWS_ASSET_URL=https://<your-blob-or-cdn>/digitalis-workspace-setup.exe
# DESKTOP_WINDOWS_VERSION=1.0.1
# NEXT_PUBLIC_DESKTOP_WINDOWS_DOWNLOAD_URL=/downloads/digitalis-workspace-setup.exe
# macOS — build via GitHub Actions (macos-latest) or on a real Mac; cannot build .dmg on Windows.
# After upload to Blob/CDN, set BOTH (Mac button stays hidden until NEXT_PUBLIC_* is set):
# DESKTOP_MAC_ASSET_URL=https://xxxxx.public.blob.vercel-storage.com/digitalis-workspace-setup.dmg
# NEXT_PUBLIC_DESKTOP_MAC_DOWNLOAD_URL=/downloads/digitalis-workspace-setup.dmg
#
# Build: npm run desktop:dist:win (Windows) and/or npm run desktop:dist:mac (macOS), then npm run desktop:sync-installer → redeploy site.
#
# Electron shell (desktop/) — optional overrides when running `DIGITALIS_WORKSPACE_ORIGIN=... npm run desktop:start`
# (NOT read by Next.js; use only when testing the Electron window against localhost). See desktop/README.md.
# DIGITALIS_WORKSPACE_ORIGIN=http://localhost:3000
# WIN_CSC_LINK=base64-or-https-url-to-your.pfx
# WIN_CSC_KEY_PASSWORD=

# Optional: Resend, push (VAPID), Jitsi, cron — copy from the main app's .env if you use those features.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# OPENAI_API_KEY=sk-...
# OPENAI_VOICE_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@example.com
# Cron (reminders + meeting reminders + trash purge). Set in Vercel Production, then redeploy.
# cron-job.org → ADVANCED → Header: Authorization = Bearer <same value as CRON_SECRET>
# Reminders URL: https://app.digitalisglobal.com/api/cron/erp-reminders  schedule: */5 * * * *
# CRON_SECRET=
# JITSI_ROOM_SECRET=
# ERP_PORTAL_ADMIN_EMAILS=
# ERP_ADMIN_EMAILS=
# NEXT_PUBLIC_ADMIN_DASHBOARD_EMAILS=
