{
  "name": "app-digitalis-erp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "node scripts/clean-next.mjs && next dev --hostname 127.0.0.1 --turbo",
    "dev:webpack": "node scripts/dev.mjs",
    "dev:clean": "node scripts/clean-next.mjs && node scripts/dev.mjs",
    "prebuild": "node scripts/clean-next.mjs",
    "build": "next build",
    "start": "next start",
    "desktop:install": "npm install --prefix desktop",
    "desktop:start": "npm run start --prefix desktop",
    "desktop:dist:win": "npm run dist:win --prefix desktop",
    "desktop:dist:mac": "npm run dist:mac --prefix desktop",
    "desktop:sync-installer": "node scripts/sync-desktop-installer.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "framer-motion": "^12.23.26",
    "isomorphic-dompurify": "^3.7.1",
    "marked": "^17.0.5",
    "next": "^14.2.0",
    "pdfkit": "^0.19.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^4.0.0",
    "turndown": "^7.2.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1"
  }
}
